#!/bin/bash
# =============================================
# /usr/local/sbin/haproxy-manager-helper (root:root 0755)
# Le sole operazioni da root di haproxy-manager, che gira come utente
# haproxy-manager e lo chiama con sudo (deploy/sudoers).
#
#   check            haproxy -c
#   reload           haproxy -c e reload
#   purge <dominio>  ban Varnish di dominio e www.dominio
#   certs            "<file> <nome> <nome>…" per ogni certificato in /etc/haproxy/certs
#   add-backend <nome> <ip>
#                    nuovo backend <nome>_backend (server Plesk su <ip>:443, come
#                    gli altri) prima di "# DEFAULT"
#   set-backend-ip <nome> <ip>
#                    sposta il server di <nome>_backend su <ip> (porta invariata)
#   remove-backend <nome>
#                    toglie <nome>_backend se nessun dominio e nessuna regola lo usa
#   certs-detail     "<file>|<scadenza>|<nomi>" per ogni certificato
#   cert-create <dominio>
#                    certificato Cloudflare Origin CA (zona e *.zona) se manca,
#                    haproxy -c, reload, sync slave; SSL Full (strict) sulla zona
#   aop-enable <dominio>
#                    Authenticated Origin Pulls: certificato client nostro sulla
#                    zona (cf-certs.py aop), poi la zona in /etc/haproxy/aop/zones.lst
#                    (HAProxy accetta solo connessioni con quel certificato);
#                    se il sito poi non risponde, toglie la zona dall'elenco.
#                    Lo avvia cert-create in background
#   cert-remove <file.pem>
#                    toglie il certificato se nessun dominio delle mappe ne ha
#                    bisogno (copia in /var/backups/haproxy/certs), reload, sync,
#                    poi lo revoca su Cloudflare
#
# Per add/set-ip/remove: haproxy -c sulla copia, backup in /var/backups/haproxy,
# reload (ripristino se fallisce), sync slave, stessa modifica nella repo.
# Gli avvisi (non errori) vanno su stdout, gli errori su stderr.
# =============================================
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CFG=/etc/haproxy/haproxy.cfg
MAPS="/etc/haproxy/maps/domains.map /etc/haproxy/maps/backends.map"
REPO=/root/server-configs
BACKUPS=/var/backups/haproxy
CERT_DIR=/etc/haproxy/certs
# Chiamate a Cloudflare e lettura dei certificati (segreti in /root/.cloudflare.env)
CFCERTS=/usr/local/lib/haproxy-manager/cf-certs.py
# Backend di servizio: non si tolgono dall'interfaccia
PROTECTED="varnish_backend default_backend grafana_backend"

# edit_cfg <file sorgente> <file destinazione> add <nome> <ip> | remove <nome>
# Stesso testo nella copia della repo (differisce solo per la password delle
# statistiche), quindi la stessa modifica vale per entrambi
edit_cfg() {
    python3 - "$@" <<'EOF'
import sys, re, datetime
src, dst, op, name = sys.argv[1:5]
s = open(src).read()
if op == "add":
    ip = sys.argv[5]
    block = (
        "# -------------------------\n"
        f"# {name.upper()} (aggiunto da haproxy-manager il {datetime.date.today():%d/%m/%Y})\n"
        "# -------------------------\n"
        f"backend {name}_backend\n"
        "    option http-keep-alive\n"
        "    timeout http-keep-alive 30s\n"
        f"    server {name} {ip}:443 ssl verify none sni req.hdr(host) alpn http/1.1 check check-ssl inter 10s rise 2 fall 3 maxconn 500\n"
        "\n"
    )
    m = re.search(r"^# -+\n# DEFAULT", s, re.M)
    if not m:
        sys.exit("punto di inserimento (# DEFAULT) non trovato in " + src)
    s = s[:m.start()] + block + s[m.start():]
elif op == "setip":
    ip = sys.argv[5]
    lines = s.splitlines(keepends=True)
    try:
        i = next(k for k, l in enumerate(lines) if l.rstrip() == f"backend {name}_backend")
    except StopIteration:
        sys.exit(f"backend {name}_backend non trovato in {src}")
    found = 0
    j = i + 1
    while j < len(lines) and not re.match(r"(#|backend |frontend |defaults|global|listen )", lines[j]):
        m = re.match(r"(\s*server\s+\S+\s+)[^\s:]+(:\d+.*)", lines[j], re.S)
        if m:
            lines[j] = m.group(1) + ip + m.group(2)
            found += 1
        j += 1
    if found != 1:
        sys.exit(f"backend {name}_backend: atteso un solo server, trovati {found}")
    s = "".join(lines)
else:
    lines = s.splitlines(keepends=True)
    try:
        i = next(k for k, l in enumerate(lines) if l.rstrip() == f"backend {name}_backend")
    except StopIteration:
        sys.exit(f"backend {name}_backend non trovato in {src}")
    # Intestazione: i commenti subito sopra (# ---- / # NOME / # ----)
    start = i
    while start > 0 and lines[start - 1].startswith("#"):
        start -= 1
    # Fino alla sezione successiva (commento a inizio riga o altra sezione)
    end = i + 1
    while end < len(lines) and not re.match(r"(#|backend |frontend |defaults|global|listen )", lines[end]):
        end += 1
    s = "".join(lines[:start] + lines[end:])
open(dst, "w").write(s)
EOF
}

# apply_cfg <messaggio di commit> <argomenti di edit_cfg dopo src/dst…>
# Va chiamata con il lock su haproxy.cfg preso
apply_cfg() {
    local msg="$1"; shift
    TMP=$(mktemp /etc/haproxy/.haproxy.cfg.XXXXXX)
    trap 'rm -f "$TMP"' EXIT
    edit_cfg "$CFG" "$TMP" "$@" >&2
    haproxy -c -q -f "$TMP" >&2 || { echo "HAProxy rifiuta la configurazione, nessuna modifica" >&2; exit 1; }
    mkdir -p "$BACKUPS"
    local bak="$BACKUPS/haproxy.cfg.$(date +%Y%m%d-%H%M%S)"
    cp -a "$CFG" "$bak"
    chmod 0644 "$TMP"; mv "$TMP" "$CFG"
    if ! systemctl reload haproxy; then
        cp -a "$bak" "$CFG"; systemctl reload haproxy || true
        echo "Reload di HAProxy fallito: configurazione precedente ripristinata" >&2; exit 1
    fi
    exec 8>&-

    sync_slave

    # Repo: stessa modifica nella copia versionata
    if cd "$REPO" 2>/dev/null && git pull --ff-only -q >/dev/null 2>&1 &&
       edit_cfg haproxy/haproxy.cfg haproxy/haproxy.cfg "$@" >/dev/null 2>&1; then
        git add haproxy/haproxy.cfg
        { git commit -q -m "$msg" >/dev/null 2>&1 && git push -q >/dev/null 2>&1; } ||
            echo "attenzione: commit o push nella repo non riuscito"
    else
        echo "attenzione: repo non aggiornata"
    fi
}

# IP del (primo) server di un backend
backend_ip() {
    awk -v b="backend $1" '$0 == b { f = 1; next } f && /^[^ \t]/ { f = 0 }
        f && $1 == "server" { split($3, a, ":"); print a[1]; exit }' "$CFG"
}

# Slave subito, senza aspettare il cron (in background: lo slave può essere lento)
sync_slave() {
    setsid -f bash -c '/usr/local/bin/sync-haproxy-slave.sh >> /var/log/haproxy-sync.log 2>&1' </dev/null >/dev/null 2>&1
}

valid_name() {
    [[ "$1" =~ ^[a-z][a-z0-9-]{0,30}$ ]] ||
        { echo "Nome non valido: lettere minuscole, cifre e -, es. server7" >&2; exit 2; }
}

valid_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    local o
    for o in "${BASH_REMATCH[@]:1}"; do
        [[ "$o" =~ ^(0|[1-9][0-9]*)$ ]] && (( o <= 255 )) || return 1
    done
}

case "${1:-}" in
    check)
        haproxy -c -q -f "$CFG"
        ;;
    reload)
        haproxy -c -q -f "$CFG"
        systemctl reload haproxy
        ;;
    purge)
        D="${2:-}"
        [[ "$D" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$ ]] ||
            { echo "dominio non valido" >&2; exit 2; }
        varnishadm ban "req.http.host ~ ^(www[.])?${D//./[.]}\$"
        ;;
    certs)
        for f in /etc/haproxy/certs/*.pem; do
            [ -f "$f" ] || continue
            names=$(openssl x509 -noout -ext subjectAltName -in "$f" 2>/dev/null |
                grep -o 'DNS:[^,[:space:]]*' | cut -c5- | tr '\n' ' ')
            echo "${f##*/} $names"
        done
        ;;
    add-backend)
        N="${2:-}" IP="${3:-}"
        valid_name "$N"
        valid_ipv4 "$IP" || { echo "Indirizzo IP non valido: $IP" >&2; exit 2; }
        B="${N}_backend"
        exec 8>/run/lock/haproxy-cfg.lock; flock 8
        grep -qE "^backend ${B}\$" "$CFG" && { echo "Il backend $B esiste già" >&2; exit 3; }
        grep -qE "^[[:space:]]*server ${N} " "$CFG" && { echo "Un server di nome $N esiste già" >&2; exit 3; }
        grep -qE "^[[:space:]]*server [^ ]+ ${IP//./\\.}:" "$CFG" &&
            { echo "$IP è già usato da un altro backend" >&2; exit 3; }
        apply_cfg "Backend $B ($IP) aggiunto da haproxy-manager" add "$N" "$IP"

        # Avviso, non errore: il server può non essere ancora pronto
        timeout 4 bash -c "</dev/tcp/$IP/443" 2>/dev/null ||
            echo "attenzione: $IP:443 non risponde ora (WireGuard/Plesk), HAProxy lo segnerà giù"
        ;;
    set-backend-ip)
        N="${2:-}" IP="${3:-}"
        valid_name "$N"
        valid_ipv4 "$IP" || { echo "Indirizzo IP non valido: $IP" >&2; exit 2; }
        B="${N}_backend"
        for p in $PROTECTED; do
            [ "$B" = "$p" ] && { echo "$B è un backend di servizio, non si modifica da qui" >&2; exit 3; }
        done
        exec 8>/run/lock/haproxy-cfg.lock; flock 8
        grep -qE "^backend ${B}\$" "$CFG" || { echo "Il backend $B non esiste" >&2; exit 3; }
        CUR=$(backend_ip "$B")
        [ "$CUR" != "$IP" ] || { echo "nessuna modifica: $B è già su $IP"; exit 0; }
        grep -qE "^[[:space:]]*server [^ ]+ ${IP//./\\.}:" "$CFG" &&
            { echo "$IP è già usato da un altro backend" >&2; exit 3; }
        apply_cfg "Backend $B: $CUR → $IP (haproxy-manager)" setip "$N" "$IP"
        timeout 4 bash -c "</dev/tcp/$IP/443" 2>/dev/null ||
            echo "attenzione: $IP:443 non risponde ora (WireGuard/Plesk), HAProxy lo segnerà giù"
        ;;
    remove-backend)
        N="${2:-}"
        valid_name "$N"
        B="${N}_backend"
        for p in $PROTECTED; do
            [ "$B" = "$p" ] && { echo "$B è un backend di servizio, non si toglie da qui" >&2; exit 3; }
        done
        exec 8>/run/lock/haproxy-cfg.lock; flock 8
        grep -qE "^backend ${B}\$" "$CFG" || { echo "Il backend $B non esiste" >&2; exit 3; }
        # Domini che lo usano (diretti o come origine dietro Varnish)
        used=$(awk -v b="$B" '$2 == b { print $1 }' $MAPS | sort -u | head -5 | tr '\n' ' ')
        [ -z "$used" ] || { echo "Il backend $B è ancora usato da: ${used% }" >&2; exit 3; }
        # Altri riferimenti nella configurazione (use_backend, default_backend…)
        grep -nE "(^|[^a-z0-9_])${B}([^a-z0-9_]|\$)" "$CFG" | grep -vqE "^[0-9]+:backend ${B}\$" &&
            { echo "Il backend $B è citato in altre regole di haproxy.cfg" >&2; exit 3; }
        apply_cfg "Backend $B rimosso da haproxy-manager" remove "$N"
        ;;
    certs-detail)
        python3 "$CFCERTS" list
        ;;
    cert-create)
        D="${2:-}"
        exec 8>/run/lock/haproxy-cfg.lock; flock 8
        OUT=$(python3 "$CFCERTS" create "$D")
        case "$OUT" in
            "EXISTS "*)
                echo "certificato già presente: ${OUT#EXISTS }"
                ;;
            "NEW "*)
                PEM="${OUT#NEW }"
                NEWF="$CERT_DIR/.$PEM.new"
                chown haproxy:haproxy "$NEWF"; chmod 0600 "$NEWF"
                mv "$NEWF" "$CERT_DIR/$PEM"
                if ! haproxy -c -q -f "$CFG" >&2; then
                    rm -f "$CERT_DIR/$PEM"
                    echo "HAProxy rifiuta il certificato $PEM: tolto" >&2; exit 1
                fi
                systemctl reload haproxy
                sync_slave
                echo "creato $PEM"
                ;;
            *)
                echo "risposta inattesa: $OUT" >&2; exit 1
                ;;
        esac
        exec 8>&-
        python3 "$CFCERTS" strict "$D" || echo "attenzione: SSL Full (strict) non impostato sulla zona"
        # Authenticated Origin Pulls in background (fino a ~1 minuto), esito in syslog
        setsid -f bash -c "$0 aop-enable '$D' 2>&1 | logger -t haproxy-aop" </dev/null >/dev/null 2>&1
        ;;
    aop-enable)
        D="${2:-}"
        [[ "$D" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$ ]] ||
            { echo "dominio non valido" >&2; exit 2; }
        LIST=/etc/haproxy/aop/zones.lst
        OUT=$(python3 "$CFCERTS" aop "$D")
        ZONE="${OUT#AOP }"
        [ -n "$ZONE" ] && [ "$ZONE" != "$OUT" ] || { echo "risposta inattesa: $OUT" >&2; exit 1; }
        if grep -qx "$ZONE" "$LIST"; then echo "$ZONE: già nell'elenco"; exit 0; fi
        # Cloudflare impiega qualche secondo a presentare il certificato
        sleep 30
        exec 8>/run/lock/haproxy-cfg.lock; flock 8
        echo "$ZONE" >> "$LIST"
        haproxy -c -q -f "$CFG" >&2 && systemctl reload haproxy
        exec 8>&-
        sleep 5
        C=$(curl -s -o /dev/null -w "%{http_code}" --max-time 20 "https://$D/?aop-check=$(date +%s)")
        if [[ "$C" =~ ^(2|3)[0-9][0-9]$ ]]; then
            sync_slave
            echo "$ZONE: Authenticated Origin Pulls attivo (verifica $D: $C)"
        else
            exec 8>/run/lock/haproxy-cfg.lock; flock 8
            sed -i "/^${ZONE//./\\.}\$/d" "$LIST"; systemctl reload haproxy
            echo "$ZONE: verifica $D fallita ($C), tolta dall'elenco" >&2; exit 1
        fi
        ;;
    cert-remove)
        F="${2:-}"
        [[ "$F" =~ ^[a-z0-9][a-z0-9.-]{0,250}\.pem$ ]] || { echo "Nome di file non valido: $F" >&2; exit 2; }
        exec 8>/run/lock/haproxy-cfg.lock; flock 8
        [ -f "$CERT_DIR/$F" ] || { echo "Il certificato $F non esiste" >&2; exit 3; }
        USED=$(python3 "$CFCERTS" used "$F")
        [ -z "$USED" ] || { echo "Il certificato $F serve ancora a: $(echo $USED | cut -c1-200)" >&2; exit 3; }
        [ "$(find "$CERT_DIR" -maxdepth 1 -name '*.pem' ! -name '.*' | wc -l)" -gt 1 ] ||
            { echo "È l'ultimo certificato: HAProxy non partirebbe senza" >&2; exit 3; }
        install -d -m 0700 "$BACKUPS/certs"
        BAK="$BACKUPS/certs/$F"
        [ -e "$BAK" ] && mv "$BAK" "$BAK.$(date +%Y%m%d-%H%M%S)"
        mv "$CERT_DIR/$F" "$BAK"
        if ! haproxy -c -q -f "$CFG" >&2; then
            mv "$BAK" "$CERT_DIR/$F"
            echo "HAProxy rifiuta la configurazione senza $F: rimesso" >&2; exit 1
        fi
        systemctl reload haproxy
        sync_slave
        exec 8>&-
        echo "tolto da HAProxy (copia in $BAK)"
        python3 "$CFCERTS" revoke "$BAK" || echo "attenzione: revoca su Cloudflare non riuscita"
        ;;
    *)
        echo "uso: $0 check|reload|purge <dominio>|certs|certs-detail|add-backend <nome> <ip>|set-backend-ip <nome> <ip>|remove-backend <nome>|cert-create <dominio>|aop-enable <dominio>|cert-remove <file.pem>" >&2
        exit 2
        ;;
esac
