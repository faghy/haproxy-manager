# HAProxy Manager Configuration (/opt/haproxy-manager/.env, root:haproxy-manager 0640)
DOMAINS_MAP=/etc/haproxy/maps/domains.map
BACKENDS_MAP=/etc/haproxy/maps/backends.map
HAPROXY_CFG=/etc/haproxy/haproxy.cfg
LOG_FILE=/var/log/haproxy-manager.log
HISTORY_FILE=/var/lib/haproxy-manager/history.jsonl
LISTEN_ADDR=127.0.0.1:8081
ADMIN_USER=admin
# Hash bcrypt, tra apici singoli (contiene "$"):
#   target/release/haproxy-manager hash-password   (legge la password da stdin)
ADMIN_PASS_HASH='$2b$12$...'
UI_DIR=/opt/haproxy-manager/ui
HELPER=/usr/local/sbin/haproxy-manager-helper
